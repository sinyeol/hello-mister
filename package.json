{
  "name": "hello-mister-v2",
  "version": "2.1.0",
  "description": "Hello Mister v2.1 MiSTer FPGA management console.",
  "author": "Hello Mister contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "npm run build && electron .",
    "desktop:review": "npm run build && electron .",
    "smoke:electron": "node scripts/smoke-electron-render.mjs",
    "package:review": "npm run build && node scripts/package-review.mjs",
    "icon": "node scripts/generate-app-icon.mjs",
    "package:portable": "npm run icon && npm run build && electron-builder --win portable",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "npm run test:ini && npm run test:fingerprint && npm run test:sd-flash && npm run test:task-queue && npm run test:phase-two && npm run test:phase-three && npm run test:phase-four && npm run test:phase-five && npm run test:phase-six && npm run test:phase-seven && npm run test:phase-eight && npm run test:phase-nine && npm run test:phase-ten && npm run test:phase-eleven && npm run test:phase-twelve && npm run test:phase-thirteen && npm run test:phase-fourteen && npm run test:phase-fifteen && npm run test:phase-sixteen && npm run test:phase-seventeen && npm run test:phase-eighteen && npm run test:phase-nineteen && npm run test:phase-twenty && npm run test:phase-twenty-one && npm run test:phase-twenty-two && npm run test:phase-twenty-three && npm run test:phase-twenty-four && npm run test:phase-twenty-five",
    "test:ini": "node scripts/test-real-ini-manager.mjs",
    "test:fingerprint": "node scripts/test-fingerprint-format.mjs",
    "test:sd-flash": "node scripts/test-sd-flash-dry-run.mjs",
    "test:task-queue": "node scripts/test-task-queue.mjs",
    "test:phase-two": "node scripts/test-phase-two-safety.mjs",
    "test:phase-three": "node scripts/test-phase-three-remote-readonly.mjs",
    "test:phase-four": "node scripts/test-phase-four-ssh-trust.mjs",
    "test:phase-five": "node scripts/test-phase-five-trust-history-and-logs.mjs",
    "test:phase-six": "node scripts/test-phase-six-profile-summary-and-rom-dry-run.mjs",
    "test:phase-seven": "node scripts/test-phase-seven-rom-dry-run-planning.mjs",
    "test:phase-eight": "node scripts/test-phase-eight-rom-transfer-policies.mjs",
    "test:phase-nine": "node scripts/test-phase-nine-rom-dry-run-validation.mjs",
    "test:phase-ten": "node scripts/test-phase-ten-rom-transfer-locks.mjs",
    "test:phase-eleven": "node scripts/test-phase-eleven-rom-readiness-reports.mjs",
    "test:phase-twelve": "node scripts/test-phase-twelve-desktop-review.mjs",
    "test:phase-thirteen": "node scripts/test-phase-thirteen-ui-simplification.mjs",
    "test:phase-fourteen": "node scripts/test-phase-fourteen-basic-mode-and-stickers.mjs",
    "test:phase-fifteen": "node scripts/test-phase-fifteen-sticker-studio-mvp.mjs",
    "test:phase-sixteen": "node scripts/test-phase-sixteen-manual-mister-flow.mjs",
    "test:phase-seventeen": "node scripts/test-phase-seventeen-connection-bridge-actions.mjs",
    "test:phase-eighteen": "node scripts/test-phase-eighteen-zaparoo-core.mjs",
    "test:phase-nineteen": "node scripts/test-phase-nineteen-zaparoo-run-diagnostics.mjs",
    "test:phase-twenty": "node scripts/test-phase-twenty-zaparoo-config-apply.mjs",
    "test:phase-twenty-one": "node scripts/test-phase-twenty-one-nfc-readiness.mjs",
    "test:phase-twenty-two": "node scripts/test-phase-twenty-two-nfc-token-events.mjs",
    "test:phase-twenty-three": "node scripts/test-phase-twenty-three-rom-file-manager.mjs",
    "test:phase-twenty-four": "node scripts/test-phase-twenty-four-custom-platforms.mjs",
    "test:phase-twenty-five": "node scripts/test-phase-twenty-five-controller-management.mjs"
  },
  "build": {
    "appId": "com.hellomister.app",
    "productName": "Hello Mister",
    "copyright": "Hello Mister contributors",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Hello-Mister-${version}-portable.exe"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "konva": "^9.3.22",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.6",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.28.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.21",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3"
  }
}
